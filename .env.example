# Postgres. Lokal pakai Postgres di laptop, produksi pakai Postgres di VPS.
DATABASE_URL="postgresql://user:pass@localhost:5432/dproabsent"

# Rahasia tanda tangan cookie sesi. Isi string acak panjang di produksi.
AUTH_SECRET="ganti-dengan-string-acak-panjang"

# Opsional. Tanpa Redis, pembatas login dan cache daftar sesi jalan di memori tiap worker.
# REDIS_URL="redis://localhost:6379"
